---
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 28 28"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Subtle rear depth edges -->
  <path
    d="M14 3.4V14M4.82 19.3L14 14M23.18 19.3L14 14"
    stroke="var(--color-electric-blue)"
    stroke-opacity="0.28"
    stroke-width="1"
    stroke-linecap="round"
  />
  <!-- Outer isometric cube rails -->
  <path
    d="M14 3.4L23.18 8.7V19.3L14 24.6L4.82 19.3V8.7L14 3.4Z"
    stroke="var(--color-electric-blue)"
    stroke-width="1.35"
    stroke-linejoin="round"
  />
  <!-- Integrated front-facing Y structure -->
  <path
    d="M4.82 8.7L14 14L23.18 8.7M14 14V24.6"
    stroke="var(--color-electric-blue)"
    stroke-width="2.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M4.82 8.7L14 14L23.18 8.7M14 14V24.6"
    stroke="var(--color-intelligence-cyan)"
    stroke-opacity="0.55"
    stroke-width="0.95"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Six spherical connection nodes -->
  <circle cx="14" cy="3.4" r="2.05" fill="var(--color-intelligence-cyan)" />
  <circle cx="23.18" cy="8.7" r="2.05" fill="var(--color-intelligence-cyan)" />
  <circle cx="23.18" cy="19.3" r="2.05" fill="var(--color-intelligence-cyan)" />
  <circle cx="14" cy="24.6" r="2.05" fill="var(--color-intelligence-cyan)" />
  <circle cx="4.82" cy="19.3" r="2.05" fill="var(--color-intelligence-cyan)" />
  <circle cx="4.82" cy="8.7" r="2.05" fill="var(--color-intelligence-cyan)" />
</svg>
