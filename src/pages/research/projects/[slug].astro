---
// src/pages/research/projects/[slug].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { RESEARCH_PROJECTS, RESEARCH_PROGRAMMES } from '../../../data/research';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return RESEARCH_PROJECTS.map((proj) => ({
    params: { slug: proj.slug },
    props: { project: proj },
  }));
};

const { project } = Astro.props;
const programme = RESEARCH_PROGRAMMES.find((p) => p.id === project.programme);

const STATUS_LABELS: Record<string, string> = {
  proposed: 'Proposed', active: 'Active', 'in-review': 'In Review',
  published: 'Published', completed: 'Completed', archived: 'Archived',
};
---

<BaseLayout
  title={`${project.id}: ${project.title} | YARA Research`}
  description={project.description}
>
  <div class="proj-hero">
    <div class="container">
      <div class="proj-breadcrumb">
        <a href="/research">Research</a>
        <span>→</span>
        <a href="/research/projects">Projects</a>
        <span>→</span>
        <span class="proj-breadcrumb-current">{project.id}</span>
      </div>

      <div class="proj-hero-inner">
        <div class="proj-meta-top">
          <span class="proj-id">{project.id}</span>
          <span class={`status-badge status-${project.status}`}>
            {STATUS_LABELS[project.status]}
          </span>
          {programme && (
            <a href={`/research/programmes/${programme.slug}`} class="proj-programme-link">
              {programme.id} · {programme.shortTitle}
            </a>
          )}
        </div>
        <h1 class="proj-title">{project.title}</h1>
        <p class="proj-subtitle">{project.subtitle}</p>
        <p class="proj-desc">{project.description}</p>
      </div>
    </div>
  </div>

  <div class="proj-body">
    <div class="container">
      <div class="proj-layout">
        <!-- Main content -->
        <main class="proj-main">
          <!-- Problem statement -->
          <section class="proj-section" aria-labelledby="problem-h">
            <h2 id="problem-h" class="proj-section-title">Problem Statement</h2>
            <p class="proj-section-body">{project.problemStatement}</p>
          </section>

          <!-- Research questions -->
          <section class="proj-section" aria-labelledby="questions-h">
            <h2 id="questions-h" class="proj-section-title">Research Questions</h2>
            <ol class="proj-questions">
              {project.researchQuestions.map((q, i) => (
                <li class="proj-question">
                  <span class="q-num">{String(i+1).padStart(2,'0')}</span>
                  <span class="q-text">{q}</span>
                </li>
              ))}
            </ol>
          </section>

          <!-- Results — honest empty state -->
          <section class="proj-section" aria-labelledby="results-h">
            <h2 id="results-h" class="proj-section-title">Results & Findings</h2>
            <div class="proj-empty-state">
              <p>
                {project.status === 'proposed'
                  ? 'This project has not yet entered active experimentation. Research questions and methodology are under development.'
                  : 'This project is currently in active research. Experimental findings will be published here as the research progresses through the YARA review lifecycle.'}
              </p>
            </div>
          </section>

          <!-- Publications -->
          <section class="proj-section" aria-labelledby="pubs-h">
            <h2 id="pubs-h" class="proj-section-title">Publications</h2>
            <div class="proj-empty-state">
              <p>No publications available yet. Papers and technical reports will appear here when research is completed and passes independent review.</p>
            </div>
          </section>
        </main>

        <!-- Sidebar -->
        <aside class="proj-sidebar" aria-label="Project details">
          <div class="sidebar-block">
            <h3 class="sidebar-title">Expected Outputs</h3>
            <ul class="sidebar-list">
              {project.expectedOutputs.map((out) => (
                <li class="sidebar-item">{out}</li>
              ))}
            </ul>
          </div>

          {project.startedDate && (
            <div class="sidebar-block">
              <h3 class="sidebar-title">Research Started</h3>
              <p class="sidebar-value">{project.startedDate}</p>
            </div>
          )}

          <div class="sidebar-block">
            <h3 class="sidebar-title">Status</h3>
            <span class={`status-badge status-${project.status}`}>
              {STATUS_LABELS[project.status]}
            </span>
          </div>

          {programme && (
            <div class="sidebar-block">
              <h3 class="sidebar-title">Research Programme</h3>
              <a href={`/research/programmes/${programme.slug}`} class="sidebar-link">
                {programme.id} · {programme.title}
              </a>
            </div>
          )}

          <div class="sidebar-block">
            <h3 class="sidebar-title">Research Transparency</h3>
            <p class="sidebar-note">
              YARA Research publishes all aspects of the research process, including
              methodology, negative findings and limitations, not only successful results.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .proj-hero {
    padding-top: calc(var(--nav-height) + 3rem);
    padding-bottom: 3.5rem;
    background: var(--color-graphite);
    border-bottom: 1px solid var(--color-border);
  }

  .proj-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .proj-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .proj-breadcrumb a:hover { color: var(--color-text-secondary); }
  .proj-breadcrumb-current { color: var(--color-text-secondary); }

  .proj-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 54ch;
  }

  .proj-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .proj-id {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-electric-blue);
  }

  .proj-programme-link {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .proj-programme-link:hover {
    color: var(--color-electric-blue);
    border-color: rgba(91,156,255,0.3);
  }

  .proj-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    line-height: 1.1;
  }

  .proj-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .proj-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  /* Body layout */
  .proj-body {
    padding-block: 4rem;
    background: var(--color-graphite);
  }

  .proj-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 4rem;
    align-items: start;
  }

  /* Main */
  .proj-main {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .proj-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .proj-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .proj-section-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
  }

  .proj-section-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 60ch;
  }

  .proj-questions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .proj-question {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .q-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-electric-blue);
    flex-shrink: 0;
  }

  .q-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .proj-empty-state {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: rgba(255,255,255,0.015);
    max-width: 54ch;
  }

  .proj-empty-state p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* Sidebar */
  .proj-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
  }

  .sidebar-block {
    padding: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .sidebar-block:last-child { border-bottom: none; }

  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sidebar-item {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    padding-left: 0.75rem;
    position: relative;
  }

  .sidebar-item::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-electric-blue);
  }

  .sidebar-value {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .sidebar-link {
    font-size: 0.8125rem;
    color: var(--color-electric-blue);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .sidebar-link:hover { opacity: 0.8; }

  .sidebar-note {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .proj-layout {
      grid-template-columns: 1fr;
    }

    .proj-sidebar {
      position: static;
    }
  }
</style>
