---
// src/pages/research/programmes/[slug].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { RESEARCH_PROGRAMMES, RESEARCH_PROJECTS } from '../../../data/research';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return RESEARCH_PROGRAMMES.map((prog) => ({
    params: { slug: prog.slug },
    props: { programme: prog },
  }));
};

const { programme } = Astro.props;

const relatedProjects = RESEARCH_PROJECTS.filter(
  (p) => p.programme === programme.id
);

const ACCENT_HEX = {
  blue: '#5B9CFF',
  cyan: '#56D9E8',
  violet: '#8B83FF',
};

const accent = ACCENT_HEX[programme.accent];
---

<BaseLayout
  title={`${programme.title} | YARA Research`}
  description={programme.description}
>
  <!-- Programme hero -->
  <div class="prog-hero" style={`--accent: ${accent};`}>
    <div class="container">
      <div class="prog-breadcrumb">
        <a href="/research">Research</a>
        <span>→</span>
        <a href="/research/programmes">Programmes</a>
        <span>→</span>
        <span class="prog-breadcrumb-current">{programme.id}</span>
      </div>

      <div class="prog-hero-inner">
        <div class="prog-id-block">
          <span class="prog-id-label" style={`color: ${accent};`}>{programme.id}</span>
          <span class="status-badge status-active">{programme.status}</span>
        </div>
        <h1 class="prog-title">{programme.title}</h1>
        <p class="prog-desc">{programme.description}</p>
      </div>
    </div>
    <!-- Accent line at top -->
    <div class="prog-accent-bar" style={`background: linear-gradient(to right, ${accent}, transparent);`} aria-hidden="true" />
  </div>

  <!-- Research areas -->
  <section class="page-section" aria-labelledby="areas-h">
    <div class="container">
      <div class="prog-two-col">
        <div class="prog-col">
          <h2 id="areas-h" class="prog-section-title">Research Areas</h2>
          <ul class="area-list">
            {programme.researchAreas.map((area) => (
              <li class="area-item">
                <span class="area-dot" style={`color: ${accent};`}>·</span>
                {area}
              </li>
            ))}
          </ul>
        </div>

        <div class="prog-col">
          <h2 class="prog-section-title">Research Questions</h2>
          <ol class="question-list">
            {programme.questions.map((q, i) => (
              <li class="question-item">
                <span class="question-num" style={`color: ${accent};`}>{String(i+1).padStart(2,'0')}</span>
                <span class="question-text">{q}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Related projects -->
  <section class="page-section page-section--alt" aria-labelledby="projects-h">
    <div class="container">
      <h2 id="projects-h" class="prog-section-title">Research Projects</h2>
      {relatedProjects.length > 0 ? (
        <div class="rel-projects">
          {relatedProjects.map((proj) => (
            <a href={`/research/projects/${proj.slug}`} class="rel-project">
              <span class="rel-proj-id">{proj.id}</span>
              <div>
                <div class="rel-proj-title">{proj.title}</div>
                <div class="rel-proj-sub">{proj.subtitle}</div>
              </div>
              <span class={`status-badge status-${proj.status}`}>{proj.status}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No research projects are currently assigned to this programme. Projects will appear here as the research agenda develops.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Publications -->
  <section class="page-section" aria-labelledby="pubs-h">
    <div class="container">
      <h2 id="pubs-h" class="prog-section-title">Publications</h2>
      <div class="empty-state">
        <p>
          Publications from this programme will appear here as research projects
          progress through the YARA review and publication lifecycle.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prog-hero {
    padding-top: calc(var(--nav-height) + 3rem);
    padding-bottom: 3.5rem;
    background: var(--color-graphite);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .prog-accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
  }

  .prog-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .prog-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .prog-breadcrumb a:hover { color: var(--color-text-secondary); }
  .prog-breadcrumb-current { color: var(--color-text-secondary); }

  .prog-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 54ch;
  }

  .prog-id-block {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .prog-id-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .prog-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    line-height: 1.1;
  }

  .prog-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .page-section {
    padding-block: 4rem;
    background: var(--color-graphite);
  }

  .page-section--alt {
    background: var(--color-midnight-navy);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .prog-section-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
  }

  .prog-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .area-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .area-item {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  .area-dot {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .question-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .question-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .question-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .question-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Related projects */
  .rel-projects {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .rel-project {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    text-decoration: none;
    transition: background 0.2s;
  }

  .rel-project:hover { background: var(--color-elevated); }

  .rel-proj-id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-electric-blue);
    white-space: nowrap;
  }

  .rel-proj-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .rel-proj-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 0.2rem;
  }

  /* Empty state */
  .empty-state {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: rgba(255,255,255,0.015);
    max-width: 54ch;
  }

  .empty-state p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .prog-two-col {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
