---
// src/pages/open-source/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Open Source | YARA Research"
  description="Open-source research repositories, frameworks, benchmarks and research tools from YARA Research."
>
  <div class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <span class="research-id">Open Source</span>
        <h1 class="page-title">Open research. Reproducible engineering.</h1>
        <p class="page-subtitle">
          YARA Research releases open-source implementations, benchmarks, datasets
          and research tools alongside its published work. Reproducibility is a
          core research requirement, not an afterthought.
        </p>
        <a
          href="https://github.com/yararesearch-ai"
          target="_blank"
          rel="noopener noreferrer"
          class="github-link"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          View on GitHub
        </a>
      </div>
    </div>
  </div>

  <!-- Categories -->
  <section class="page-section" aria-label="Open source categories">
    <div class="container">
      <div class="os-categories">
        {[
          { label: 'Research Frameworks', desc: 'Reusable frameworks developed during research projects', count: 0 },
          { label: 'Experimental Implementations', desc: 'Code produced during experiments and prototyping', count: 0 },
          { label: 'Benchmarks', desc: 'Evaluation harnesses and benchmark datasets', count: 0 },
          { label: 'Datasets', desc: 'Research datasets and curated data collections', count: 0 },
          { label: 'Research Utilities', desc: 'Tools that support research activities', count: 0 },
          { label: 'Developer Tools', desc: 'Tools released for the broader developer community', count: 0 },
        ].map(({ label, desc, count }) => (
          <div class="os-category">
            <div class="os-cat-header">
              <h2 class="os-cat-title">{label}</h2>
              <span class="os-cat-count">{count} repos</span>
            </div>
            <p class="os-cat-desc">{desc}</p>
            <div class="os-cat-empty">
              <span>Repositories will appear here as research progresses.</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Open source principles -->
      <div class="os-principles">
        <h2 class="principles-title">Open Source Principles</h2>
        <div class="principles-grid">
          {[
            { title: 'Apache 2.0 or MIT licensing', desc: 'Research software is released under permissive licences wherever possible.' },
            { title: 'Reproducibility first', desc: 'Code includes instructions to reproduce research results, not only run the software.' },
            { title: 'No star-chasing', desc: 'We release code when it is ready and useful, not to maximise GitHub stars.' },
            { title: 'Honest documentation', desc: 'Limitations and known issues are documented clearly alongside capabilities.' },
          ].map(({ title, desc }) => (
            <div class="principle-card">
              <h3 class="principle-title">{title}</h3>
              <p class="principle-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--nav-height) + 4rem);
    padding-bottom: 4rem;
    background: var(--color-graphite);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 54ch;
  }

  .page-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    line-height: 1.1;
  }

  .page-subtitle {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    width: fit-content;
  }

  .github-link:hover {
    border-color: rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.04);
  }

  .page-section {
    padding-block: 4rem;
    background: var(--color-graphite);
  }

  /* Categories */
  .os-categories {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-border);
    margin-bottom: 4rem;
  }

  .os-category {
    padding: 2rem;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .os-cat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .os-cat-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .os-cat-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .os-cat-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .os-cat-empty {
    padding: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: 3px;
    background: rgba(255,255,255,0.01);
  }

  .os-cat-empty span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  /* Principles */
  .principles-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-border);
  }

  .principle-card {
    padding: 1.5rem;
    background: var(--color-midnight-navy);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .principle-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .principle-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .os-categories, .principles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
